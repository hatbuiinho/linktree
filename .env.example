# PostgreSQL
DATABASE_URL="postgresql://user:password@host:5432/database"

# Optional seed account email. The first seed generates a random password and
# stores it locally in .admin-credentials.
ADMIN_EMAIL="admin@ttpq.local"

# MinIO / S3-compatible image storage
MINIO_ENDPOINT="minio.example.com"
MINIO_ACCESS_KEY="access-key"
MINIO_SECRET_KEY="secret-key"
MINIO_BUCKET="ttpq"
MINIO_REGION="us-east-1"
MINIO_USE_SSL="true"
MINIO_PUBLIC_BASE_URL="https://minio.example.com/ttpq"

# adapter-node / Docker production settings. Vercel sets VERCEL automatically.
ORIGIN="https://ttpq.hatbuinho.me"
HOST="0.0.0.0"
PORT="3000"
